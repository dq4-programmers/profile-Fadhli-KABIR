            const container = document.getElementById('categoryContainer');
            container.innerHTML = categories.map(cat => `
                <div onclick="selectCategory('${cat.name}')" class="group bg-gaming-card border border-gaming-border hover:border-gaming-primary p-5 rounded-2xl cursor-pointer transition-all hover:scale-[1.02] flex flex-col items-center text-center">
                    <div class="w-12 h-12 rounded-xl bg-gaming-dark border border-gaming-border group-hover:border-gaming-primary flex items-center justify-center text-gaming-neon mb-3 transition-colors">
                        <i class="${cat.icon} text-lg"></i>
                    </div>
                    <h3 class="gaming-font text-xs font-bold text-white mb-1 group-hover:text-gaming-neon transition-colors">${cat.name}</h3>
                    <span class="text-[10px] text-gray-500">${cat.count} Produk</span>
                </div>
            `).join('');
        }

        // Render Filter Buttons
        function renderFilterButtons() {
            const container = document.getElementById('filterButtons');
            const uniqueCats = ["all", ...new Set(products.map(p => p.category))];
            
            container.innerHTML = uniqueCats.map(cat => `
                <button onclick="filterProducts('${cat}')" data-category="${cat}" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold ${cat === 'all' ? 'bg-gaming-primary text-white shadow-md' : 'bg-gaming-card border border-gaming-border text-gray-300 hover:border-gaming-primary'} transition-all">
                    ${cat === 'all' ? 'Semua Produk' : cat}
                </button>
            `).join('');
        }

        // Select Category from UI Cards
        function selectCategory(catName) {
            const normalizedCat = catName === "Semua" ? "all" : catName;
            filterProducts(normalizedCat);
            // Smooth scroll to product section
            document.getElementById('produk').scrollIntoView({ behavior: 'smooth' });
        }

        // Filter Products by Category & Search
        function filterProducts(category) {
            currentCategory = category;
            
            // Update active state on buttons
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if(btn.dataset.category === category) {
                    btn.className = "filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-gaming-primary text-white shadow-md transition-all";
                } else {
                    btn.className = "filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-gaming-card border border-gaming-border text-gray-300 hover:border-gaming-primary transition-all";
                }
            });

            filterAndRender();
        }

        function filterAndRender() {
            let filtered = products;

            if (currentCategory !== 'all') {
                filtered = filtered.filter(p => p.category === currentCategory);
            }

            if (searchQuery) {
                filtered = filtered.filter(p => p.name.toLowerCase().includes(searchQuery) || p.specs.toLowerCase().includes(searchQuery));
            }

            renderProducts(filtered);
        }

        // Render Product List
        function renderProducts(items) {
            const grid = document.getElementById('productGrid');
            const emptyState = document.getElementById('emptyState');

            if (items.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            grid.innerHTML = items.map(product => `
                <div class="bg-gaming-card border border-gaming-border hover:border-gaming-primary/60 rounded-2xl overflow-hidden group transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <!-- Product Image Wrapper -->
                        <div class="relative h-48 bg-gaming-dark overflow-hidden">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x400/13151f/8b5cf6?text=NEXUS+GEAR'">
                            <div class="absolute top-3 left-3 bg-gaming-dark/80 backdrop-blur-md border border-gaming-border px-3 py-1 rounded-lg text-[10px] font-bold text-gaming-neon uppercase">
                                ${product.badge}
                            </div>
                            <div class="absolute top-3 right-3 bg-gaming-card/90 px-2 py-1 rounded-lg text-[10px] text-gray-400 font-semibold">
                                Stok: ${product.stock}
                            </div>
                        </div>

                        <!-- Product Content -->
                        <div class="p-5">
                            <span class="text-[10px] uppercase font-bold text-gaming-primary tracking-widest">${product.category}</span>
                            <h3 class="gaming-font text-sm font-bold text-white mt-1 group-hover:text-gaming-neon transition-colors line-clamp-1">${product.name}</h3>
                            <p class="text-gray-400 text-xs mt-2 line-clamp-2">${product.specs}</p>
                        </div>
                    </div>

                    <!-- Price & Add To Cart Button -->
                    <div class="p-5 pt-0 flex items-center justify-between border-t border-gaming-border/40 mt-3 pt-3">
                        <div>
                            <span class="text-[10px] text-gray-500 line-through block">${formatRupiah(product.originalPrice)}</span>
                            <span class="text-sm font-extrabold text-white">${formatRupiah(product.price)}</span>
                        </div>
                        <button onclick="addToCart(${product.id})" class="w-10 h-10 rounded-xl bg-gaming-primary hover:bg-gaming-primary/80 text-white flex items-center justify-center transition-all shadow-md group-hover:scale-105 active:scale-95">
                            <i class="fa-solid fa-cart-plus text-xs"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Cart Drawer Control
        function toggleCart() {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('cartOverlay');
            
            if(drawer.classList.contains('translate-x-full')) {
                drawer.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                drawer.classList.add('translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        // Toggle Mobile Menu
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Add Product to Cart
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            const existingItem = cart.find(item => item.id === productId);

            if (existingItem) {
                if (existingItem.quantity < product.stock) {
                    existingItem.quantity++;
                    showToast(`Jumlah ${product.name} ditambah dalam keranjang!`, 'success');
                } else {
                    showToast(`Stok maksimum tercapai!`, 'error');
                    return;
                }
            } else {
                cart.push({ ...product, quantity: 1 });
                showToast(`${product.name} berhasil ditambahkan ke keranjang!`, 'success');
            }

            updateCartUI();
        }

        // Update Quantity in Cart
        function updateQuantity(productId, change) {
            const item = cart.find(i => i.id === productId);
            if (!item) return;

            item.quantity += change;
            if (item.quantity <= 0) {
                cart = cart.filter(i => i.id !== productId);
                showToast(`Item dihapus dari keranjang.`, 'info');
            }

            updateCartUI();
        }

        // Update Cart UI Elements & Badges
        function updateCartUI() {
            const badge = document.getElementById('cartBadge');
            const container = document.getElementById('cartItemsContainer');
            const footer = document.getElementById('cartFooter');
            
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);

            // Update Badge Count
            if (totalItems > 0) {
                badge.innerText = totalItems;
                badge.classList.remove('scale-0');
                footer.classList.remove('hidden');
            } else {
                badge.classList.add('scale-0');
                footer.classList.add('hidden');
            }

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-20">
                        <div class="w-16 h-16 bg-gaming-dark border border-gaming-border rounded-2xl flex items-center justify-center mx-auto mb-4 text-gray-500 text-2xl">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                        <h4 class="gaming-font text-sm font-bold text-gray-300">Keranjang Kosong</h4>
                        <p class="text-gray-500 text-xs mt-1">Belum ada gear gaming yang ditambahkan.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = cart.map(item => `
                <div class="flex items-center gap-4 bg-gaming-dark border border-gaming-border p-3 rounded-xl">
                    <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg">
                    <div class="flex-1">
                        <h4 class="gaming-font text-xs font-bold text-white line-clamp-1">${item.name}</h4>
                        <span class="text-xs text-gaming-neon font-semibold">${formatRupiah(item.price)}</span>
                        <div class="flex items-center gap-3 mt-2">
                            <button onclick="updateQuantity(${item.id}, -1)" class="w-6 h-6 rounded bg-gaming-card border border-gaming-border flex items-center justify-center text-gray-300 hover:text-white">-</button>
                            <span class="text-xs font-bold text-white">${item.quantity}</span>
                            <button onclick="updateQuantity(${item.id}, 1)" class="w-6 h-6 rounded bg-gaming-card border border-gaming-border flex items-center justify-center text-gray-300 hover:text-white">+</button>
                        </div>
                    </div>
                    <button onclick="updateQuantity(${item.id}, -${item.quantity})" class="text-gray-500 hover:text-red-400 p-2">
                        <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                </div>
            `).join('');

            // Calculate Subtotal & Totals
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const tax = subtotal * 0.10;
            const total = subtotal + tax;

            document.getElementById('cartSubtotal').innerText = formatRupiah(subtotal);
            document.getElementById('cartTax').innerText = formatRupiah(tax);
            document.getElementById('cartTotal').innerText = formatRupiah(total);
        }

        // Checkout Simulation
        function checkout() {
            if (cart.length === 0) return;

            showToast("Pesanan berhasil dibuat! Terima kasih telah berbelanja di NEXUS.", "success");
            cart = [];
            updateCartUI();
            toggleCart();
        }

        // Toast Notification System
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            let borderColor = type === 'success' ? 'border-emerald-500/50 bg-emerald-950/90' : type === 'error' ? 'border-red-500/50 bg-red-950/90' : 'border-gaming-primary/50 bg-gaming-card';
            let icon = type === 'success' ? 'fa-circle-check text-emerald-400' : type === 'error' ? 'fa-circle-xmark text-red-400' : 'fa-circle-info text-gaming-neon';

            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border ${borderColor} backdrop-blur-md shadow-2xl text-xs text-white transform translate-y-4 opacity-0 transition-all duration-300`;
            toast.innerHTML = `
                <i class="fa-solid ${icon} text-sm"></i>
                <span class="font-medium">${message}</span>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-4', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('translate-y-4', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
